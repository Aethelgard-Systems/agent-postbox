# Pinned official Node 22 (LTS) image by digest (multi-arch manifest)
FROM node:22-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914

WORKDIR /app

# Ensure non-root ownership of workspace
RUN chown -R node:node /app

# agent-postbox has zero runtime dependencies; npm ci verifies clean lockfile state
COPY --chown=node:node package.json package-lock.json ./
RUN npm ci

COPY --chown=node:node src ./src
COPY --chown=node:node test ./test
COPY --chown=node:node templates ./templates
COPY --chown=node:node examples ./examples
COPY --chown=node:node LICENSE NOTICE README.md ./

USER node

CMD ["npm", "test"]
