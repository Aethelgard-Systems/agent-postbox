{
  "name": "agent-postbox",
  "mcpName": "io.github.Aethelgard-Systems/agent-postbox",
  "version": "0.2.0",
  "description": "Verifiable handoffs for MCP agents: AI coworkers collaborate through GitHub Issues and PRs with bounded writes, receipts, read-back and a signed evidence log.",
  "license": "Apache-2.0",
  "author": "Marco Gernand",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aethelgard-Systems/agent-postbox.git"
  },
  "homepage": "https://github.com/Aethelgard-Systems/agent-postbox#readme",
  "bugs": {
    "url": "https://github.com/Aethelgard-Systems/agent-postbox/issues"
  },
  "type": "module",
  "bin": {
    "agent-postbox": "src/cli.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src/",
    "templates/",
    "LICENSE",
    "NOTICE",
    "README.md",
    "docs/evidence-format.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "demo": "node examples/offline-demo/demo.mjs",
    "demo:slow": "node examples/offline-demo/demo.mjs --slow",
    "demo:handoff": "node examples/offline-demo/handoff-demo.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "github-issues",
    "multi-agent",
    "code-review",
    "handoff",
    "audit-log",
    "evidence"
  ],
  "dependencies": {}
}
